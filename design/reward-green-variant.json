{
  "markup": "<section class=\"ka-reward\" aria-labelledby=\"ka-reward-title\"><div class=\"ka-reward-heading\">${icons.gift}<h2 id=\"ka-reward-title\">Баллы за поездку</h2><span>${icons.check} Начислены</span></div><p class=\"ka-reward-amount\"><strong>+1 120</strong> баллов</p><p class=\"ka-reward-copy\">На скидку в следующей поездке.<br>Бронируйте отели выгоднее в «Ключах».</p><div class=\"ka-reward-actions\"><button type=\"button\" class=\"kh-detail-link\" data-after=\"points\">Как использовать ${icons.arrow}</button><button type=\"button\" class=\"ka-reward-search\" data-after=\"find\">Выбрать отель</button></div></section>",
  "css": "padding:16px;border:1px solid color-mix(in srgb,var(--color-success) 14%,var(--color-success-bg));border-radius:20px;background:var(--color-success-bg)}\n#keysUnifiedPrototype .ka-reward-heading{display:flex;align-items:center;gap:8px}\n#keysUnifiedPrototype .ka-reward-heading>svg{width:20px;height:20px;color:var(--color-brand)}\n#keysUnifiedPrototype#keysUnifiedPrototype .ka-home .ka-reward-heading h2{font-size:var(--text-14)!important;line-height:var(--leading-normal)!important}\n#keysUnifiedPrototype .ka-reward-heading>span{display:flex;align-items:center;gap:4px;margin-left:auto;color:var(--color-success);font-size:var(--text-12);line-height:var(--leading-normal)}\n#keysUnifiedPrototype .ka-reward-heading>span svg{width:12px;height:12px}\n#keysUnifiedPrototype .ka-reward-amount{display:flex;align-items:baseline;gap:6px;margin:12px 0 4px;color:var(--color-brand);font-size:var(--text-14)}\n#keysUnifiedPrototype#keysUnifiedPrototype .ka-reward-amount strong{font-size:var(--text-20)!important;line-height:var(--leading-tight)!important;font-weight:var(--font-weight-medium)!important;font-variant-numeric:tabular-nums}\n#keysUnifiedPrototype .ka-reward-copy{margin:0;color:var(--color-muted);font-size:var(--text-12);line-height:var(--leading-normal)}\n#keysUnifiedPrototype .ka-reward-actions{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:12px}\n#keysUnifiedPrototype .ka-reward-actions>.kh-detail-link{min-height:44px;padding:0;border:0;background:transparent}\n#keysUnifiedPrototype .ka-home .ka-reward-search{min-height:44px;padding:10px 12px;border:0;border-radius:12px;background:var(--color-brand-solid);color:var(--color-on-brand);font-size:var(--text-12);font-weight:var(--font-weight-medium)}\n@media(max-width:359px){#keysUnifiedPrototype .ka-reward-heading{flex-wrap:wrap}#keysUnifiedPrototype .ka-reward-heading>span{margin-left:28px;flex-basis:100%}}\n"
}
